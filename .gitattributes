# Generated assembly and stubs. These carry "Code generated by ... DO NOT EDIT."
# headers, but GitHub does not infer that for .s files, so mark them explicitly:
# they collapse in diffs and are excluded from language stats and review requests.
# The reviewable surface is the generator and the tests, not their output.
tests/**/*.s linguist-generated=true
tests/**/stub.go linguist-generated=true
